{
  "name": "app",
  "version": "1.0.1",
  "main": "index.ts",
  "dependencies": {
    "@expo-google-fonts/manrope": "^0.4.3",
    "@expo/vector-icons": "^15.0.2",
    "@noble/ciphers": "2.4.0",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "expo": "~58.0.26",
    "expo-build-properties": "~58.0.12",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.8",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-keep-awake": "~58.0.4",
    "expo-secure-store": "~58.0.3",
    "expo-status-bar": "~58.0.5",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1"
  },
  "devDependencies": {
    "@types/jest": "30.0.0",
    "@types/node": "22.20.5",
    "@types/react": "~19.3.0",
    "@types/ws": "8.18.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "typescript": "~6.0.3",
    "ws": "8.23.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "test": "jest",
    "lint": "eslint .",
    "test:interop": "cargo build --manifest-path ../desktop/Cargo.toml --example interop_server && INTEROP_SERVER_BIN=$(pwd)/../desktop/target/debug/examples/interop_server jest src/__tests__/interop.test.ts"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?)|expo(nent)?|@expo(nent)?/.*|@expo-google-fonts/.*|react-navigation|@react-navigation/.*|@noble/.*)"
    ]
  },
